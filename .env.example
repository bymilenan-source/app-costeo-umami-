# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase
# (Project Settings → API en app.supabase.com)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para el servidor (rutas /api/admin/*). NUNCA la expongas al navegador
# ni la subas a un repositorio público.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
