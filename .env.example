# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase
# (Project Settings → API en app.supabase.com)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para el servidor (rutas /api/admin/*). NUNCA la expongas al navegador
# ni la subas a un repositorio público.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Notificaciones push (avisos de pedidos). Genera el par de claves una sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com

# Protege la ruta /api/cron/check-orders; Vercel la envía sola si configuras
# esta variable en el proyecto (ver vercel.json para el horario del cron).
CRON_SECRET=una-cadena-aleatoria-larga
